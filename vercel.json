{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/index.js" }
  ],
  "env": {
    "CHAIN": "abstract",
    "COLLECTION_SLUG": "hamieverse-genesis"
  },
  "functions": {
    "index.js": {
      "runtime": "nodejs20.x"
    }
  }
}
